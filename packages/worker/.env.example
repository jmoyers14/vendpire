# Environment identity: local | staging | production
#
# `local` is load-bearing, not cosmetic: it selects InlineTaskQueue (which POSTs
# tasks straight back to /tasks/* instead of using Cloud Tasks) and the
# allow-all /tasks/* guard. Any other value demands the GCP settings below.
ENVIRONMENT=local

# Build stamp — injected by the deploy pipeline; leave unset locally.
# APP_VERSION=
# GIT_SHA=
# BUILT_AT=

# HTTP server. 3211 so it sits beside the api's 3210.
PORT=3211

# MongoDB connection string — the same database the api uses.
MONGODB_URI=mongodb://localhost:27017/vendpire

# Clerk webhook signing secret (whsec_… from the Clerk dashboard → Webhooks).
# Verifies inbound webhook signatures. The worker boots without checking it;
# it's read the first time a webhook arrives, so a real secret is only needed
# when you actually deliver one.
CLERK_WEBHOOK_SIGNING_SECRET=

# The worker's own base URL. Locally it's where InlineTaskQueue delivers tasks;
# deployed it is also the OIDC audience the queue signs callback tokens for.
WORKER_URL=http://localhost:3211

# Cloud Tasks — required only when ENVIRONMENT is not local (set by deploy.sh).
# GCP_PROJECT_ID=
# GCP_LOCATION=us-central1
# TASKS_INVOKER_SERVICE_ACCOUNT=

# Log level: trace | debug | info | warn | error (default info)
# LOG_LEVEL=info
