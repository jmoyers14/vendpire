# API origin the browser calls
VITE_API_URL=http://localhost:3000

# Clerk publishable key (safe in the bundle)
VITE_CLERK_PUBLISHABLE_KEY=

# PostHog (optional — analytics is a no-op without a key)
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Build stamp — baked in by the deploy pipeline; leave unset locally.
# VITE_APP_VERSION=
# VITE_GIT_SHA=
# VITE_BUILT_AT=
