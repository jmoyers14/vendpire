{
  "name": "@vendpire/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc --noEmit",
    "openapi": "bun scripts/generateOpenApi.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.6.1",
    "@trpc/server": "11.19.0",
    "@vendpire/domain": "workspace:*",
    "@vendpire/platform": "workspace:*",
    "cors": "^2.8.5",
    "mongoose": "9.7.0",
    "posthog-node": "^5.38.0",
    "reflect-metadata": "^0.2.1",
    "trpc-to-openapi": "3.3.3",
    "tsyringe": "^4.8.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zod-openapi": "5.4.6"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/cors": "^2.8.17",
    "bun-types": "^1.0.0",
    "typescript": "^5.3.3"
  }
}
