# Environment identity: local | staging | production
ENVIRONMENT=local

# Build stamp — injected by the deploy pipeline; leave unset locally.
# APP_VERSION=
# GIT_SHA=
# BUILT_AT=

# HTTP server
PORT=3000
WEB_URL=http://localhost:5173

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/vendpire

# Clerk — the api verifies session JWTs with the secret key
CLERK_SECRET_KEY=

# Google Maps Platform key with Places API (New) enabled (optional — the
# address autocomplete feature is disabled without it)
# GOOGLE_MAPS_API_KEY=

# PostHog (optional — capture is a no-op without a key)
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# Log level: trace | debug | info | warn | error (default info)
# LOG_LEVEL=info
