# Environment identity: local | staging | production
ENVIRONMENT=local

# Build stamp — injected by the deploy pipeline; leave unset locally.
# APP_VERSION=
# GIT_SHA=
# BUILT_AT=

# HTTP server. 3000 is the code default; local dev overrides it to 3211, which
# is what the MCP resource URL below has to agree with.
PORT=3000
WEB_URL=http://localhost:5173

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/vendpire

# Clerk — the api verifies session JWTs with the secret key
CLERK_SECRET_KEY=

# MCP endpoint for AI assistants (optional — `/mcp` is not mounted without
# both). The resource URL is the public address of `/mcp`; the Frontend API URL
# is shown under Clerk Dashboard → API keys.
#
# The resource URL must match the MCP server registered in Clerk CHARACTER FOR
# CHARACTER, port included: tokens carry it as their audience and the server
# rejects any token minted for a different one.
# MCP_RESOURCE_URL=http://localhost:3211/mcp
# CLERK_FRONTEND_API_URL=https://your-instance.clerk.accounts.dev

# Google Maps Platform key with Places API (New) enabled (optional — the
# address autocomplete feature is disabled without it)
# GOOGLE_MAPS_API_KEY=

# PostHog (optional — capture is a no-op without a key)
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# Log level: trace | debug | info | warn | error (default info)
# LOG_LEVEL=info
