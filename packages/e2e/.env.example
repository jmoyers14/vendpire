# Clerk dev-instance keys — required for any browser test (the web app won't
# boot without a publishable key). Use the same dev instance as local dev.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# A dedicated password test user in that Clerk dev instance. Signed-in specs
# skip when these are unset.
E2E_CLERK_USER_EMAIL=
E2E_CLERK_USER_PASSWORD=
