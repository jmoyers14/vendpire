#!/usr/bin/env bash
#
# Build / test / run the iOS app without opening Xcode.
#
# Pinned to Xcode 26.1 explicitly: this machine also has Xcode 16.4, and
# `xcode-select` has pointed at it before, which silently breaks CLI builds
# of an iOS 18 target. Override DEVELOPER_DIR or VENDPIRE_SIM to change either.
set -euo pipefail

readonly IOS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly SCHEME="Vendpire"
readonly DERIVED="$IOS_DIR/build/DerivedData"
readonly PRODUCTS="$DERIVED/Build/Products/Debug-iphonesimulator"

export DEVELOPER_DIR="${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer}"
SIM="${VENDPIRE_SIM:-iPhone 17 Pro}"

# Resolve a simulator name to a UDID, preferring the newest runtime — a name
# like "iPhone 16" exists on several runtimes and simctl rejects the ambiguity.
resolveSim() {
  if [[ "$SIM" =~ ^[0-9A-F-]{36}$ ]]; then
    echo "$SIM"
    return
  fi
  xcrun simctl list devices available -j | python3 -c '
import json, sys
name = sys.argv[1]
best = None
for runtime, devices in json.load(sys.stdin)["devices"].items():
    if "iOS" not in runtime:
        continue
    version = [int(p) for p in runtime.rsplit(".", 1)[-1].split("-")[1:]]
    for device in devices:
        if device["name"] == name and (best is None or version > best[0]):
            best = (version, device["udid"])
if not best:
    sys.exit(f"No available simulator named {name!r}. Try: xcrun simctl list devices available")
print(best[1])
' "$SIM"
}

build() {
  xcodebuild -project "$IOS_DIR/$SCHEME.xcodeproj" -scheme "$SCHEME" \
    -destination "generic/platform=iOS Simulator" \
    -derivedDataPath "$DERIVED" \
    build "$@"
}

# UI tests dominate the run (~50s for testLaunchPerformance alone) and this
# phase has none worth keeping, so they're skipped rather than deleted.
runTests() {
  local udid; udid="$(resolveSim)"
  xcodebuild -project "$IOS_DIR/$SCHEME.xcodeproj" -scheme "$SCHEME" \
    -destination "platform=iOS Simulator,id=$udid" \
    -derivedDataPath "$DERIVED" \
    -skip-testing:VendpireUITests \
    test "$@"
}

launch() {
  local udid; udid="$(resolveSim)"
  build
  local bundleId
  bundleId="$(plutil -extract CFBundleIdentifier raw "$PRODUCTS/$SCHEME.app/Info.plist")"
  xcrun simctl boot "$udid" 2>/dev/null || true
  open -a Simulator
  xcrun simctl install "$udid" "$PRODUCTS/$SCHEME.app"
  # Non-blocking by default so `run` can be followed by `screenshot`.
  # Pass --console-pty to stream the app's stdout instead.
  xcrun simctl launch "$@" "$udid" "$bundleId"
}

screenshot() {
  local udid; udid="$(resolveSim)"
  local out="${1:-$IOS_DIR/build/screenshot.png}"
  xcrun simctl io "$udid" screenshot "$out"
  echo "$out"
}

case "${1:-}" in
  build)      shift; build "$@" ;;
  test)       shift; runTests "$@" ;;
  run)        shift; launch "$@" ;;
  screenshot) shift; screenshot "$@" ;;
  *) echo "usage: Scripts/xc {build|test|run|screenshot [path]}" >&2; exit 64 ;;
esac
