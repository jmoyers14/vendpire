<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode merges its generated keys into this file at build time; only the
	     custom ones need to be declared here. Values are substituted from the
	     active Config/*.xcconfig. -->
	<key>ClerkPublishableKey</key>
	<string>$(CLERK_PUBLISHABLE_KEY)</string>
	<key>VendpireAPIBaseURL</key>
	<string>$(VENDPIRE_API_BASE_URL)</string>
	<!-- Lagoon has no dark palette yet. -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<key>NSCameraUsageDescription</key>
	<string>The camera reads barcodes while you log a purchase.</string>
	<!-- Debug field-testing talks cleartext HTTP to the Mac's .local name on
	     the same Wi-Fi; ATS exempts only loopback by default. Local traffic
	     only — remote URLs stay HTTPS-enforced. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Debug builds talk to the Vendpire server on your Mac.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
