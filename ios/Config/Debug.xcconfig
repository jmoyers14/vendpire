// Vendpire — Debug build settings.
//
// Values live here rather than in Swift so no environment detail is ever
// hardcoded in a source file. Environment.swift reads them back out of the
// generated Info.plist at runtime.
//
// Gotcha: `//` begins a comment in xcconfig, so a literal URL is silently
// truncated ("https://host" becomes "https:"). $(SLASH) is the usual escape.
SLASH = /

// A separate app identity so a dev build installs beside the staging app
// instead of replacing it — the staging app holds real data.
BUNDLE_ID_SUFFIX = .debug
APP_DISPLAY_NAME = Vendpire Dev
APP_ICON_NAME = AppIconDev

// Clerk publishable key for the dynamic-kit-6657 dev instance.
// Publishable (pk_) keys are PUBLIC by design — deploy.sh bakes this same value
// into every web bundle we serve — so it's committed rather than kept local.
CLERK_PUBLISHABLE_KEY = pk_test_ZHluYW1pYy1raXQtNjY1Ny5jbGVyay5hY2NvdW50cy5kZXYk

// The only server the app talks to. The `/api/v1` suffix belongs in the base
// URL: the generated client appends the operation path and nothing else, so it
// never applies the document's own `servers:` entry.
// The simulator shares the Mac's network so localhost resolves. On a phone,
// localhost is the phone: override this in Local.xcconfig with the Mac's
// Bonjour name (e.g. http://My-Mac.local:3211/api/v1).
// Port 3211 is this worktree's API port — worktrees differ, check before use.
VENDPIRE_API_BASE_URL = http:$(SLASH)$(SLASH)localhost:3211$(SLASH)api$(SLASH)v1

// Per-machine overrides, gitignored. Last, so its values win.
#include? "Local.xcconfig"
