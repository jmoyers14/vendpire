// Zenvend — Release build settings. See Debug.xcconfig for the $(SLASH) note.
SLASH = /

// The real app identity. Debug.xcconfig suffixes it so both can be installed.
BUNDLE_ID_SUFFIX =
APP_DISPLAY_NAME = Zenvend
APP_ICON_NAME = AppIcon

// The Clerk production instance (clerk.zenvend.app).
CLERK_PUBLISHABLE_KEY = pk_live_Y2xlcmsuemVudmVuZC5hcHAk

// The production API (see DEPLOY.md). The `/api/v1` suffix is part of the base
// URL — see Debug.xcconfig for why.
ZENVEND_API_BASE_URL = https:$(SLASH)$(SLASH)api.zenvend.app$(SLASH)api$(SLASH)v1
